    ]
  },
  {
    title: "AI",
    badges: [
      { name: "ChatGPT", src: "https://img.shields.io/badge/ChatGPT-282828?style=for-the-badge&logo=openaigym&logoColor=white" },
      { name: "Claude", src: "https://img.shields.io/badge/Claude-000000?style=for-the-badge&logo=claude&logoColor=white" },
