---

<section id="skills" class="section reveal">
  <div class="container">
    <h2 class="section-title">Skills</h2>
    <p class="section-subtitle">Technologies and tools I use to deliver production-ready software.</p>
    <div class="skill-grid">
      {skillGroups.map((group) => (
        <article class="skill-row">
          <h3>{group.title}</h3>
          <div class="badges-row">
            {group.badges.map((badge) => (
              <img class="skill-badge" src={badge.src} alt={badge.name} loading="lazy" />
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skill-grid {
    display: grid;
    gap: 1rem;
  }
  .skill-row {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1rem;
  }
  .skill-row h3 {
    margin: 0 0 0.75rem;
    color: var(--text);
    font-size: 1rem;
  }
  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .skill-badge {
    height: 34px;
    width: auto;
    border-radius: 999px;
    transition: transform 0.2s ease-in-out;
  }
  .skill-badge:hover {
    transform: translateY(-2px) scale(1.02);
  }
</style>
