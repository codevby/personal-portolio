---
const projects = [
  {
    title: "MyParadaysTravel",
    description:
      "Vacation travel agency website with service showcase, business information, and conversion-focused content.",
    tech: ["Angular", "Express.js", "MongoDB"],
    image: "/images/projects/project1.png",
    demo: "https://myparadaystravel.com/",
    demoLabel: "Live Demo",
  },
];
---

<section id="projects" class="section reveal">
  <div class="container">
    <h2 class="section-title">Projects</h2>
    <p class="section-subtitle">
      A selection of software and creative projects I have worked on.
    </p>
    <div class="grid cards">
      {
        projects.map((project) => (
          <article class="card">
            <img
              src={project.image}
              alt={`${project.title} cover`}
              loading="lazy"
            />
            <div class="card-content">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <p class="tech">{project.tech.join(" • ")}</p>
              <div class="links">
                <a
                  class="demo-btn"
                  href={project.demo}
                  target="_blank"
                  rel="noreferrer"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10.5 3a7.5 7.5 0 1 0 4.71 13.34l4.22 4.22a1 1 0 0 0 1.41-1.41l-4.22-4.22A7.5 7.5 0 0 0 10.5 3Zm0 2a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11Z" />
                  </svg>
                  <span>{project.demoLabel}</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards {
    grid-template-columns: 1fr;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .card-content {
    padding: 1rem;
  }
  .card h3 {
    margin: 0 0 0.3rem;
  }
  .card p {
    margin: 0.45rem 0;
    color: var(--muted);
  }
  .tech {
    font-weight: 700;
    color: var(--text);
    font-size: 0.95rem;
  }
  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.8rem;
  }
  .demo-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.55rem 0.85rem;
    color: var(--primary);
    background: color-mix(in oklab, var(--surface) 90%, var(--primary));
    font-weight: 700;
  }
  .demo-btn svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .demo-btn:hover {
    color: var(--secondary);
    border-color: var(--secondary);
    transform: translateY(-1px);
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
